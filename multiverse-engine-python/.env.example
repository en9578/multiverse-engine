# DashScope (Bailian) API Key
DASHSCOPE_API_KEY=sk-your-key-here

# PostgreSQL (LangGraph checkpoint)
PG_URL=postgresql://postgres:postgres@localhost:5432/multiverse

# Redis (shared state / pub-sub)
